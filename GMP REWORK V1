    while PlayerTab and PlayerTab.Parent and PlayerTabGlow and PlayerTabGlow.Parent do
        local elapsed = os.clock() - playerTabCycleStart
        local t = (elapsed % PLAYER_CYCLE_SECONDS) / PLAYER_CYCLE_SECONDS
        local hue = 0.75 - (0.15 * (0.5 + 0.5 * math.sin(t * math.pi * 2)))
        local neon = Color3.fromHSV(hue, 0.85, 1)
        PlayerTabGlow.BackgroundColor3 = neon
        RunService.Heartbeat:Wait()
    end
end)

