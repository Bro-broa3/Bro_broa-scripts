-- ============================================
-- EXPAND / COLLAPSE
-- ============================================
local expanded = false
local animating = false

local EXPAND_SIZE = UDim2.new(0, 150, 0, 70)

local EXPAND_DURATION   = 0.35
local COLLAPSE_DURATION = 0.8

local function expand()
    if animating or expanded then return end
    animating = true
    expanded = true

    local info = TweenInfo.new(EXPAND_DURATION, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

    CloseBtn.Visible = true
    MinBtn.Visible = true
    MaxBtn.Visible = true

    TweenService:Create(BarContainer, info, {Size = EXPAND_SIZE}):Play()
    TweenService:Create(SmallBar, info, {BackgroundTransparency = 1}):Play()
    TweenService:Create(SmallStroke, info, {Transparency = 1}):Play()
    TweenService:Create(RedCircle, info, {BackgroundTransparency = 1}):Play()
    TweenService:Create(YellowCircle, info, {BackgroundTransparency = 1}):Play()
    TweenService:Create(GreenCircle, info, {BackgroundTransparency = 1}):Play()

    task.wait(EXPAND_DURATION)
    animating = false
    SmallBar.Visible = false
end

local function collapse()
    if animating or not expanded then return end
    animating = true
    expanded = false

    SmallBar.Visible = true

    local slowInfo = TweenInfo.new(COLLAPSE_DURATION, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    local fastInfo = TweenInfo.new(EXPAND_DURATION, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

    TweenService:Create(BarContainer, fastInfo, {Size = UDim2.new(0, 0, 0, 0)}):Play()
    TweenService:Create(SmallBar,     slowInfo, {BackgroundTransparency = 0.55}):Play()
    TweenService:Create(SmallStroke,  slowInfo, {Transparency = 0.7}):Play()
    TweenService:Create(RedCircle,    slowInfo, {BackgroundTransparency = 0}):Play()
    TweenService:Create(YellowCircle, slowInfo, {BackgroundTransparency = 0}):Play()
    TweenService:Create(GreenCircle,  slowInfo, {BackgroundTransparency = 0}):Play()

    task.wait(COLLAPSE_DURATION)
    animating = false
    CloseBtn.Visible = false
    MinBtn.Visible = false
    MaxBtn.Visible = false
end

SmallBar.MouseButton1Click:Connect(function()
    if expanded then
        collapse()
    else
        expand()
    end
end)

-- ============================================
-- CLICK OUTSIDE → COLLAPSE
-- ============================================
local function isInside(guiObject, position)
    local absPos = guiObject.AbsolutePosition
    local absSize = guiObject.AbsoluteSize
    return position.X >= absPos.X and position.X <= absPos.X + absSize.X
       and position.Y >= absPos.Y and position.Y <= absPos.Y + absSize.Y
end

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if not expanded then return end
    if animating then return end

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        local pos = input.Position

        local insideButtonBar = isInside(ButtonBar, pos)
        local insideCloseBtn = isInside(CloseBtn, pos)
        local insideMinBtn = isInside(MinBtn, pos)
        local insideMaxBtn = isInside(MaxBtn, pos)
        local insideSmallBar = SmallBar.Visible and isInside(SmallBar, pos)

        if not (insideButtonBar or insideCloseBtn or insideMinBtn or insideMaxBtn or insideSmallBar) then
            collapse()
        end
    end
end)

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseButton1
    and input.UserInputType ~= Enum.UserInputType.Touch then return end
    if not expanded then return end
    if animating then return end

    task.wait()
    task.wait()

    if expanded and not animating then
        collapse()
    end
end)

