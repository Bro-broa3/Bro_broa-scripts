local CIRCLE_MIN_SIZE    = 40
local CIRCLE_MAX_SIZE    = 140
local CIRCLE_MAX_OPACITY = 0.15
local CIRCLE_MIN_OPACITY = 0.05
local CIRCLE_LIFETIME    = 6
local CIRCLE_SPAWN_RATE  = 0.6
local CIRCLE_DRIFT_PX    = 40

local function spawnCircle()
    local Circle = Instance.new("Frame")
    Circle.Parent = CircleLayer
    Circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Circle.BorderSizePixel = 0
    Circle.BackgroundTransparency = 1
    Circle.ZIndex = 0
    Circle.Active = false

    local size = math.random(CIRCLE_MIN_SIZE, CIRCLE_MAX_SIZE)
    Circle.Size = UDim2.new(0, size, 0, size)

    local posX = math.random(-10, 90) / 100
    local posY = math.random(-10, 90) / 100
    Circle.Position = UDim2.new(posX, 0, posY, 0)

    local CircleCorner = Instance.new("UICorner")
    CircleCorner.CornerRadius = UDim.new(1, 0)
    CircleCorner.Parent = Circle

    local driftX = math.random(-CIRCLE_DRIFT_PX, CIRCLE_DRIFT_PX)
    local driftY = math.random(-CIRCLE_DRIFT_PX, CIRCLE_DRIFT_PX)

    local peakOpacity = math.random(
        math.floor(CIRCLE_MIN_OPACITY * 100),
        math.floor(CIRCLE_MAX_OPACITY * 100)
    ) / 100
    local peakTransparency = 1 - peakOpacity

    local fadeIn = TweenInfo.new(CIRCLE_LIFETIME * 0.35, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    local fadeOut = TweenInfo.new(CIRCLE_LIFETIME * 0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.In)

    TweenService:Create(Circle, fadeIn, {BackgroundTransparency = peakTransparency}):Play()

    local driftTween = TweenInfo.new(CIRCLE_LIFETIME, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    TweenService:Create(Circle, driftTween, {
        Position = UDim2.new(posX + driftX / MainFrame.AbsoluteSize.X, 0, posY + driftY / MainFrame.AbsoluteSize.Y, 0)
    }):Play()

    task.delay(CIRCLE_LIFETIME * 0.5, function()
        TweenService:Create(Circle, fadeOut, {BackgroundTransparency = 1}):Play()
    end)

    task.delay(CIRCLE_LIFETIME + 0.5, function()
        if Circle and Circle.Parent then
            Circle:Destroy()
        end
    end)
end

task.spawn(function()
    while MainFrame and MainFrame.Parent do
        spawnCircle()
        task.wait(CIRCLE_SPAWN_RATE)
    end
end)

