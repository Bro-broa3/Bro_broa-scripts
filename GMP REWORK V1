            BackgroundColor3 = Color3.fromRGB(80, 200, 120),
            BackgroundTransparency = 0.2
        }):Play()
        Content.Visible = true
        currentTab = tab
    end

    tab.Select = selectTab
    Tab.MouseButton1Click:Connect(selectTab)

    table.insert(allTabs, tab)
    return tab
end

