-- ============================================
-- MINIMIZE / RESTORE
-- ============================================
local minimized = false
local maximized = false

local function minimizeGUI()
    if minimized then return end
    minimized = true

    MinimizePill.Visible = false

    local info = TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.InOut)
    local targetSize = UDim2.new(MainFrame.Size.X.Scale, MainFrame.Size.X.Offset, 0, 0)

    TweenService:Create(MainFrame, info, {Size = targetSize}):Play()
    TweenService:Create(MainFrame, info, {BackgroundTransparency = 1}):Play()

    task.wait(0.45)

    MainFrame.Visible = false
    MainFrame.BackgroundTransparency = 0
    MinimizePill.Visible = true
end

local function restoreGUI()
    if not minimized then return end
    minimized = false

    MinimizePill.Visible = false

    MainFrame.Visible = true
    MainFrame.Size = UDim2.new(SIZE_NORMAL.X.Scale, 0, 0, 0)
    MainFrame.BackgroundTransparency = 1

    local finalSize = maximized and SIZE_MAX or SIZE_NORMAL

    local info = TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    TweenService:Create(MainFrame, info, {Size = finalSize}):Play()
    TweenService:Create(MainFrame, info, {BackgroundTransparency = 0}):Play()
end

MinBtn.MouseButton1Click:Connect(function()
    minimizeGUI()
end)

MinimizePill.MouseButton1Click:Connect(function()
    restoreGUI()
end)

