-- ============================================
-- MAXIMIZE TOGGLE
-- ============================================
MaxBtn.MouseButton1Click:Connect(function()
    maximized = not maximized

    local targetSize      = maximized and SIZE_MAX or SIZE_NORMAL
    local targetTitle     = maximized and TITLE_SIZE_MAX or TITLE_SIZE_NORMAL
    local targetTabStart  = maximized and TAB_START_MAX or TAB_START_NORMAL
    local targetTabEnd    = maximized and TAB_END_MAX or TAB_END_NORMAL

    local info = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

    if not minimized then
        TweenService:Create(MainFrame, info, {Size = targetSize}):Play()
        TweenService:Create(TitleBar, info, {Size = targetTitle}):Play()
        TweenService:Create(TabHolder, info, {
            Position = UDim2.new(0, 8, 0, targetTabStart),
            Size = UDim2.new(0.14, 0, 1, targetTabEnd)
        }):Play()
        TweenService:Create(ContentHolder, info, {
            Position = UDim2.new(0.15, 4, 0, targetTabStart),
            Size = UDim2.new(0.85, -12, 1, targetTabEnd)
        }):Play()
    else
        applyLayoutForState(maximized)
    end
end)

-- ============================================
-- PILL DRAG
-- ============================================
local pillDragging = false
local pillDragStart, pillStartPos
local pillDragInput

local function pillUpdate(input)
    local delta = input.Position - pillDragStart
    MinimizePill.Position = UDim2.new(
        pillStartPos.X.Scale, pillStartPos.X.Offset + delta.X,
        pillStartPos.Y.Scale, pillStartPos.Y.Offset + delta.Y
    )
end

MinimizePill.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        pillDragging = true
        pillDragStart = input.Position
        pillStartPos = MinimizePill.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                pillDragging = false
            end
        end)
    end
end)

MinimizePill.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        pillDragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if pillDragging and input == pillDragInput then
        pillUpdate(input)
    end
end)

