HistoryButton.MouseButton1Click:Connect(function() toggleHistoryPanel() end)
LoopToggle.MouseButton1Click:Connect(function() mainLoopOn=not mainLoopOn; applyLoopState() end)
PlayButton.MouseButton1Click:Connect(function() local url=UrlTextBox.Text; if url=="" then StatusLabel.Text="Error: Please enter URL"; return end; if string.sub(string.lower(url),-4)~=".mp3" then StatusLabel.Text="Error: URL must end with .mp3"; return end; local fn="audio.mp3"; local pts=string.split(url,"/"); if #pts>0 and string.find(pts[#pts],".mp3") then fn=string.gsub(string.gsub(pts[#pts],"%%20"," "),"%%25","%%") end; playMusicFromUrl(url,fn) end)
PauseButton.MouseButton1Click:Connect(function() if not currentSound then return end; togglePause() end)
StopButton.MouseButton1Click:Connect(function() stopMusic(); StatusLabel.Text="Music Stopped" end)
SpeedUpButton.MouseButton1Click:Connect(function() updateSpeed(math.min(currentSpeed+0.25,100)) end)
SpeedDownButton.MouseButton1Click:Connect(function() updateSpeed(math.max(currentSpeed-0.25,0)) end)
VolumeUpButton.MouseButton1Click:Connect(function() updateVolume(math.min(currentVolume+0.5,100)) end)
VolumeDownButton.MouseButton1Click:Connect(function() updateVolume(math.max(currentVolume-0.5,0)) end)
MuteToggle.MouseButton1Click:Connect(function() isGameMuted=not isGameMuted; MuteToggle.Text=isGameMuted and "UNMUTE" or "MUTE GAME" end)
MiniPlayToggle.MouseButton1Click:Connect(function() miniPlayMode=not miniPlayMode; updateMiniPlayToggle(); if miniPlayMode then if ScreenGui then ScreenGui.Enabled=false end; if MiniScreenGui then MiniScreenGui.Enabled=true end else if ScreenGui then ScreenGui.Enabled=true end; if MiniScreenGui then MiniScreenGui.Enabled=false end end end)
MiniShowButton.MouseButton1Click:Connect(function() miniPlayMode=not miniPlayMode; updateMiniPlayToggle(); if miniPlayMode then if ScreenGui then ScreenGui.Enabled=false end; if MiniScreenGui then MiniScreenGui.Enabled=true end else if ScreenGui then ScreenGui.Enabled=true end; if MiniScreenGui then MiniScreenGui.Enabled=false end end end)
MiniPauseImageButton.MouseButton1Click:Connect(function() if not currentSound then return end; togglePause() end)
MiniRewindImageButton.MouseButton1Click:Connect(function() if currentSound then currentSound.TimePosition=math.max(currentSound.TimePosition-10,0) end end)
MiniForwardImageButton.MouseButton1Click:Connect(function() if currentSound then currentSound.TimePosition=math.min(currentSound.TimePosition+10,currentSound.TimeLength) end end)

