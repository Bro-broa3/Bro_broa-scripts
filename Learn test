end

F.applyEffect = function(effectName)
    State.soundEffect=effectName
    local effect=nil
    for _,e in ipairs(Effects) do if e.name==effectName then effect=e; break end end
    if not effect or not State.currentSound then return end
    pcall(function() for _,v in pairs({State.currentSound:FindFirstChild("EqualizerSoundEffect"),State.currentSound:FindFirstChild("ReverbSoundEffect"),State.currentSound:FindFirstChild("EchoSoundEffect")}) do if v then v:Destroy() end end end)
    if effectName=="Default" then State.currentSound.PlaybackSpeed=State.speed; return end
    State.currentSound.PlaybackSpeed=State.speed*effect.speed
    if effect.bass~=1 or effect.treble~=1 then pcall(function() local eq=Instance.new("EqualizerSoundEffect"); eq.Parent=State.currentSound; eq.LowGain=math.clamp((effect.bass-1)*15,-20,20); eq.MidGain=math.clamp(((effect.bass+effect.treble)/2-1)*8,-12,12); eq.HighGain=math.clamp((effect.treble-1)*15,-20,20) end) end
    if effect.reverb>0.01 then pcall(function() local r=Instance.new("ReverbSoundEffect"); r.Parent=State.currentSound; r.DryLevel=math.clamp(1-effect.reverb,0.2,1); r.WetLevel=math.clamp(effect.reverb,0,1); r.DecayTime=effect.reverb*5 end) end
    if effect.echo>0.01 then pcall(function() local ec=Instance.new("EchoSoundEffect"); ec.Parent=State.currentSound; ec.DryLevel=math.clamp(1-effect.echo,0.3,1); ec.WetLevel=math.clamp(effect.echo,0,0.8); ec.Delay=effect.echo*0.5; ec.Feedback=effect.echo*0.7 end) end
end

F.playMusic = function(url, name, index)
    if State.currentSound then pcall(function() State.currentSound:Stop(); State.currentSound:Destroy() end) end
    State.currentSound=nil; State.playlistConnection=nil
    State.isPlaying=false; State.isPaused=false; State.pausedTime=0
    State.songName=F.cleanName(name); State.playlistIndex=index or 0
    if GUI.StatusLabel then F.updateText(GUI.StatusLabel, "⏬ Loading..."); GUI.StatusLabel.TextColor3=Color3.fromRGB(255,200,100) end
    if GUI.MiniSongLabel then GUI.MiniSongLabel.Text=State.songName end
    if GUI.ExtraSong then GUI.ExtraSong.Text=State.songName end
    if GUI.PauseButton then F.updateText(GUI.PauseButton, "⏸ PAUSE") end
    if GUI.PlayButton then F.updateText(GUI.PlayButton, "▶ PLAY") end
    if GUI.playingSong and State.playingTab then GUI.playingSong.Text='Now Playing: <font color="#ff9944">'..State.songName..'</font>' end
    
    local function createPlay(soundId)
        State.currentSound=Instance.new("Sound")
        State.currentSound.Name="MusicPlayerSound"; State.currentSound.SoundId=soundId
        State.currentSound.Volume=State.volume; State.currentSound.Looped=State.isLooping; State.currentSound.PlaybackSpeed=State.speed
        State.currentSound.Parent=workspace
        State.currentSound.Ended:Connect(function()
            if State.playlistLoop and #State.songs>0 then
                local ni=State.playlistIndex+1; if ni>#State.songs then ni=1 end
                if State.songs[ni] then pcall(function() F.playMusic(State.songs[ni].url,State.songs[ni].fileName,ni) end) end
            elseif not State.isLooping then
                State.isPlaying=false; State.isPaused=false
                if GUI.PauseButton then F.updateText(GUI.PauseButton, "▶ RESUME") end
                if GUI.MiniPauseBtn then GUI.MiniPauseBtn.Image="rbxassetid://110560238983134" end
                if GUI.ExtraPauseBtn then GUI.ExtraPauseBtn.Image="rbxassetid://110560238983134" end
            end
        end)
        State.currentSound:Play(); State.isPlaying=true; State.isPaused=false
        if State.soundEffect~="Default" then F.applyEffect(State.soundEffect) end
        if GUI.StatusLabel then GUI.StatusLabel.Text="🎵 "..State.songName; GUI.StatusLabel.TextColor3=Color3.fromRGB(100,255,100) end
        table.insert(State.history,1,{url=url,fileName=name,timestamp=os.time(),date=os.date("%Y-%m-%d %H:%M:%S")})
        if #State.history>50 then for i=51,#State.history do State.history[i]=nil end end
        F.saveJSON(P.history,State.history)
        F.updateTimeDisplay(); return true
    end
    
    if State.musicCache[url] and isfile and isfile(State.musicCache[url]) then return createPlay(getcustomasset(State.musicCache[url])) end
    local ok,result=pcall(function() local d=game:HttpGet(url); local fn=P.folder.."/Cache/cache_"..os.time()..".mp3"; writefile(fn,d); State.musicCache[url]=fn; F.saveJSON(P.cache,State.musicCache); return getcustomasset(fn) end)
    if ok and result then return createPlay(result) else F.notify("Error","❌ Failed to load music!",3); F.stopMusic(); return false end
end

F.togglePause = function()
    if not State.currentSound then return end
    if State.isPaused then State.currentSound.TimePosition=State.pausedTime; State.currentSound:Resume(); State.isPaused=false; State.isPlaying=true; F.updateText(GUI.PauseButton,"⏸ PAUSE")
    elseif State.isPlaying then State.pausedTime=State.currentSound.TimePosition; State.currentSound:Pause(); State.isPaused=true; State.isPlaying=false; F.updateText(GUI.PauseButton,"▶ RESUME")
    else State.currentSound.TimePosition=0; State.currentSound:Play(); State.isPlaying=true; State.isPaused=false; F.updateText(GUI.PauseButton,"⏸ PAUSE") end
    if GUI.PlayButton then F.updateText(GUI.PlayButton,"▶ PLAY") end
    F.updateTimeDisplay()
end

F.updateVolume = function(v) State.volume=math.clamp(v,0,100); if GUI.VolumeBox then GUI.VolumeBox.Text=string.format("%.2f",State.volume) end; if GUI.VolumeLabel then GUI.VolumeLabel.Text="Volume: "..string.format("%.2f",State.volume) end; if State.currentSound then State.currentSound.Volume=State.volume end end
F.updateSpeed = function(s) State.speed=math.clamp(s,0,100); if GUI.SpeedBox then GUI.SpeedBox.Text=string.format("%.2f",State.speed).."x" end; if GUI.SpeedLabel then GUI.SpeedLabel.Text="Speed: "..string.format("%.2f",State.speed).."x" end; if State.currentSound then State.currentSound.PlaybackSpeed=State.speed end end

F.loadPlaylist = function()
    State.songs={}
    local ok,data=pcall(function() return game:HttpGet("https://raw.githubusercontent.com/Bro-broa3/PrimeMusic/refs/heads/main/Playlist") end)
    if ok and data then 
        local index=1
        for line in string.gmatch(data,"[^\r\n]+") do 
            line=line:gsub("^%s+",""):gsub("%s+$","")
            if line~="" then 
                local cp=line:find(" , ") or line:find(",")
                local url=line; local img=""
                if cp then url=line:sub(1,cp-1); img=line:sub(cp+1) end
                url=url:gsub("^%s+",""):gsub("%s+$","")
                img=img:gsub("^%s+",""):gsub("%s+$","")
                if url~="" and url:find(".mp3") then 
                    local fn="audio.mp3"
                    local pts=url:split("/")
                    if #pts>0 and pts[#pts]:find(".mp3") then fn=pts[#pts]:gsub("%%20"," "):gsub("%%25","%%") end
                    table.insert(State.songs,{url=url,fileName=fn,imageUrl=img,imageAsset="",isDefault=true})
                    index=index+1
                end
            end
        end
    end
    for _,song in ipairs(State.userPlaylist) do table.insert(State.songs,song) end
end

F.checkKey = function(input)
    local ok,fetched=pcall(function() return game:HttpGet("https://raw.githubusercontent.com/Bro-broa3/PrimeMusic/refs/heads/main/Key") end)
    if ok and fetched then State.secretKey=tostring(fetched):gsub("^%s+",""):gsub("%s+$","") end
    if tostring(input)==State.secretKey then 
        State.keyCorrect=true
        if GUI.KeyBox then GUI.KeyBox.Text="" end
        if State.rememberKey then F.saveJSON(P.key,{rememberKey=State.rememberKey,isKeyCorrect=true}) end
        F.loadPlaylist()
        F.notify("GitHub MP3 Player","✅ Key correct!",3)
        if GUI.PlaylistScroll then F.updatePlaylistDisplay() end
        return true
    else 
        if GUI.KeyBox then GUI.KeyBox.Text="" end
        F.notify("GitHub MP3 Player","❌ Wrong key!",3)
        return false 
    end
end

F.downloadImage = function(url)
    if type(url) ~= "string" or url=="" then return "" end
    url=url:gsub("^%s+",""):gsub("%s+$","")
    if State.imageCache[url] and isfile and isfile(State.imageCache[url].file) then return State.imageCache[url].asset end
    local hash=0; for i=1,#url do hash=(hash*31+string.byte(url,i))%10000000 end
    local ext=".jpeg"; if url:lower():find(".png") then ext=".png" elseif url:lower():find(".jpg") then ext=".jpg" elseif url:lower():find(".webp") then ext=".webp" elseif url:lower():find(".gif") then ext=".gif" end
    local fn=P.folder.."/Images/img_"..hash..ext
    pcall(function() local d=game:HttpGet(url); if d and #d>100 then writefile(fn,d) end end)
    if isfile and isfile(fn) then local ok,asset=pcall(function() return getcustomasset(fn) end); if ok and asset~="" then State.imageCache[url]={file=fn,asset=asset}; F.saveJSON(P.imageCache,State.imageCache); return asset end end
    return url
end

