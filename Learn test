    local s, r = pcall(function() if readfile and isfile and isfile(SETTINGS_FILE) then return HttpService:JSONDecode(readfile(SETTINGS_FILE)) end end)
    if s and r then
        if r.theme then currentTheme=r.theme end
        if r.saveThemeEnabled~=nil then saveThemeEnabled=r.saveThemeEnabled end
        if r.rememberKeyEnabled~=nil then rememberKeyEnabled=r.rememberKeyEnabled end
        if r.timeSliderBlue~=nil then timeSliderBlue=r.timeSliderBlue end
        if r.keybindEnabled~=nil then keybindEnabled=r.keybindEnabled end
        if r.autoTranslateEnabled~=nil then autoTranslateEnabled=r.autoTranslateEnabled end
    end
end

local function saveSettings()
    pcall(function()
        if writefile then
            writefile(SETTINGS_FILE, HttpService:JSONEncode({
                theme=currentTheme, saveThemeEnabled=saveThemeEnabled, rememberKeyEnabled=rememberKeyEnabled,
                timeSliderBlue=timeSliderBlue, keybindEnabled=keybindEnabled, autoTranslateEnabled=autoTranslateEnabled
            }))
        end
    end)
end

