                TweenService:Create(TimeLabel, TweenInfo.new(0.5), {TextColor3 = c}):Play()
                if MiniSongLabel and MiniSongLabel.Text ~= "" then
                    TweenService:Create(MiniSongLabel, TweenInfo.new(0.5), {TextColor3 = c}):Play()
                end
                ci = ci + 1
                if ci > #rainbowColorList then ci = 1 end
            end
            wait(0.5)
        end
        rainbowAnimation = nil
    end)
end

