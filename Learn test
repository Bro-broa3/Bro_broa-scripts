function loadPlaylist()
    playlistSongs={}
    local s,data=pcall(function() return game:HttpGet("https://raw.githubusercontent.com/Bro-broa3/PrimeMusic/refs/heads/main/Playlist") end)
    if s and data then
        for line in string.gmatch(data,"[^\r\n]+") do
            line=string.gsub(line,"^%s+",""); line=string.gsub(line,"%s+$","")
            if line~="" and string.find(line,".mp3") then
                local fn="audio.mp3"
                local pts=string.split(line,"/")
                if #pts>0 and string.find(pts[#pts],".mp3") then fn=string.gsub(string.gsub(pts[#pts],"%%20"," "),"%%25","%%") end
                table.insert(playlistSongs,{url=line,fileName=fn,imageUrl="",imageAsset="",isDefault=true})
            end
        end
    end
    for _,song in ipairs(userPlaylist) do table.insert(playlistSongs,song) end
end

function checkSecretKey(input)
    local s,fetchedKey=pcall(function() return game:HttpGet("https://raw.githubusercontent.com/Bro-broa3/PrimeMusic/refs/heads/main/Key") end)
    if s and fetchedKey then fetchedKey=string.gsub(fetchedKey,"^%s+",""); fetchedKey=string.gsub(fetchedKey,"%s+$",""); secretKey=fetchedKey end
    if input==secretKey then
        isKeyCorrect=true
        SecretKeyTextBox.Text=""
        loadPlaylist()
        -- Force update the ExtraMiniToggle after key is correct
        if ExtraMiniToggle then
            ExtraMiniToggle.Text = extraMiniPlayMode and "ON" or "OFF"
            ExtraMiniToggle.BackgroundColor3 = Color3.fromRGB(80,180,80)
        end
        showNotification("GitHub MP3 Player","Key correct!",3)
        if isSearchOpen and currentSearchTab=="Playlist" then updatePlaylistDisplay() end
        return true
    else
        SecretKeyTextBox.Text=""
        showNotification("GitHub MP3 Player","Wrong key!",3)
        return false
    end
end

