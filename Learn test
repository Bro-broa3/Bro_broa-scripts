local function cleanAllEffects()
    if currentSound then
        pcall(function() for _, v in pairs({currentSound:FindFirstChild("EqualizerSoundEffect"), currentSound:FindFirstChild("ReverbSoundEffect"), currentSound:FindFirstChild("EchoSoundEffect")}) do if v then v:Destroy() end end end)
    end
end

local function applySoundEffect(effectName)
    currentSoundEffect=effectName
    local effect=nil
    for _, e in ipairs(soundEffectPresets) do if e.name==effectName then effect=e; break end end
    if not effect then return end
    cleanAllEffects()
    if effectName=="Default" then if currentSound then currentSound.PlaybackSpeed=currentSpeed end; return end
    if currentSound then
        currentSound.PlaybackSpeed=currentSpeed*effect.speed
        if effect.bass~=1 or effect.treble~=1 then pcall(function() local eq=Instance.new("EqualizerSoundEffect"); eq.Parent=currentSound; eq.LowGain=math.clamp((effect.bass-1)*15,-20,20); eq.MidGain=math.clamp(((effect.bass+effect.treble)/2-1)*8,-12,12); eq.HighGain=math.clamp((effect.treble-1)*15,-20,20) end) end
        if effect.reverb>0.01 then pcall(function() local reverb=Instance.new("ReverbSoundEffect"); reverb.Parent=currentSound; reverb.DryLevel=math.clamp(1-effect.reverb,0.2,1); reverb.WetLevel=math.clamp(effect.reverb,0,1); reverb.DecayTime=effect.reverb*5 end) end
        if effect.echo>0.01 then pcall(function() local echo=Instance.new("EchoSoundEffect"); echo.Parent=currentSound; echo.DryLevel=math.clamp(1-effect.echo,0.3,1); echo.WetLevel=math.clamp(effect.echo,0,0.8); echo.Delay=effect.echo*0.5; echo.Feedback=effect.echo*0.7 end) end
    end
end

