        TitleBar.BackgroundColor3 = t.titleBg
        if UIStroke then UIStroke.Color = t.outlineColor end
    end
end

local function updateLoopToggleDisplay()
    if LoopToggle then LoopToggle.Text = mainLoopOn and "LOOP: ON" or "LOOP: OFF" end
end

local function applyLoopState()
    if mainLoopOn then isLooping=true else isLooping=false end
    if currentSound then currentSound.Looped=isLooping end
    updateLoopToggleDisplay()
end

local function applyExtraLoopState()
    applyLoopState()
end

local function setupKeybind()
    if not keybindEnabled then return end
    UserInputService.InputBegan:Connect(function(input,gp)
        if gp then return end
        if input.KeyCode==Enum.KeyCode.H then
            if ScreenGui then ScreenGui.Enabled = not ScreenGui.Enabled end
        elseif input.KeyCode==Enum.KeyCode.P then
            if currentSound then togglePause() end
        elseif input.KeyCode==Enum.KeyCode.S then
            stopMusic()
        elseif input.KeyCode==Enum.KeyCode.M then
            isGameMuted = not isGameMuted
            if MuteToggle then MuteToggle.Text = isGameMuted and "UNMUTE" or "MUTE GAME" end
        elseif input.KeyCode==Enum.KeyCode.L then
            mainLoopOn=not mainLoopOn; applyLoopState()
        end
    end)
end

local function playMusicFromUrl(url, fn, playlistIdx)
    local newIndex=playlistIdx or 0
    if currentSound then pcall(function() currentSound:Stop(); currentSound:Destroy() end); currentSound=nil end
    isPlaying=false; isPaused=false; pausedTimePosition=0
    currentSongName=cleanSongName(fn); currentPlaylistIndex=newIndex
    
    if StatusLabel then StatusLabel.Text="Loading..." end
    if MiniSongLabel then MiniSongLabel.Text=currentSongName end
    updateTranslatableText(PauseButton, "PAUSE")
    updateTranslatableText(PlayButton, "PLAY")
    if playingSongLabel then playingSongLabel.Text="Now Playing: "..currentSongName end
    
    if TimeLabel and currentSongName~="" then stopRainbowAnimation(); startRainbowAnimation() end
    
    local function createAndPlaySound(soundId)
        currentSound=Instance.new("Sound")
        currentSound.Name="MusicPlayerSound"
        currentSound.SoundId=soundId
        currentSound.Volume=currentVolume
        currentSound.Looped=isLooping
        currentSound.PlaybackSpeed=currentSpeed
        currentSound.Parent=workspace
        
        currentSound.Ended:Connect(function()
            isPlaying = false
            isPaused = false
            -- Only increment play count when song actually ends
            incrementPlayCount(currentSongName)
            updateTranslatableText(PauseButton, "RESUME")
            
            if playlistLoopEnabled and #playlistSongs>0 then
                local ni=currentPlaylistIndex+1
                if ni>#playlistSongs then ni=1 end
                local song=playlistSongs[ni]
                if song then playMusicFromUrl(song.url,song.fileName,ni) end
            end
        end)
        
        currentSound:Play()
        isPlaying=true; isPaused=false
        if currentSoundEffect~="Default" then applySoundEffect(currentSoundEffect) end
        if StatusLabel then StatusLabel.Text="Playing: "..currentSongName end
        updateTimeDisplay()
        return true
    end
    
    if musicCache[url] and musicCache[url].fileName then
        local cf=musicCache[url].fileName
        if isfile and isfile(cf) then return createAndPlaySound(getcustomasset(cf)) end
    end
    
    local success,result=pcall(function()
        local d=game:HttpGet(url)
        local ts=os.time()
        local cfn=CACHE_FOLDER.."/cache_"..ts..".mp3"
        writefile(cfn,d)
        musicCache[url]={fileName=cfn,timestamp=ts}
        return getcustomasset(cfn)
    end)
    
    if success and result then
        return createAndPlaySound(result)
    else
        showNotification("Error","Failed to load music!",3)
        stopMusic()
        return false
    end
end

