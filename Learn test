-- CRITICAL FIX: translate now checks type before UrlEncode
F.translate = function(text)
    if text == nil then return "" end
    if type(text) == "table" then
        -- If it's a table, try to extract a string
        if text.Text then text = text.Text end
        if type(text) ~= "string" then text = tostring(text) end
    end
    if type(text) ~= "string" then text = tostring(text) end
    if text == "" or State.language == "en" or not State.autoTranslate then return text end
    
    local key = text.."|"..State.language
    if State.translationCache[key] then return State.translationCache[key] end
    
    local result = text
    pcall(function()
        local encoded = S.HTTP:UrlEncode(text)
        local url = "https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl="..State.language.."&dt=t&q="..encoded
        local response = game:HttpGet(url)
        local decoded = S.HTTP:JSONDecode(response)
        if decoded and decoded[1] and decoded[1][1] and decoded[1][1][1] then 
            result = tostring(decoded[1][1][1])
            State.translationCache[key] = result
        end
    end)
    return result
end

F.registerTranslation = function(elem, text) 
    if elem and text ~= nil then 
        table.insert(State.translatable, {element=elem, original=tostring(text)}) 
    end 
end

F.updateText = function(elem, text)
    if not elem then return end
    if text == nil then text = "" end
    if type(text) == "table" then
        if text.Text then text = text.Text end
        if type(text) ~= "string" then text = tostring(text) end
    end
    if type(text) ~= "string" then text = tostring(text) end
    
    local strText = text
    local found = false
    for _,item in ipairs(State.translatable) do 
        if item.element == elem then 
            item.original = strText
            found = true
            break 
        end 
    end
    if not found then F.registerTranslation(elem, strText) end
    elem.Text = State.autoTranslate and F.translate(strText) or strText
end

F.applyTranslations = function()
    for _,item in ipairs(State.translatable) do
        if item.element and item.element.Parent then 
            item.element.Text = State.autoTranslate and F.translate(item.original) or item.original
        end
    end
end

