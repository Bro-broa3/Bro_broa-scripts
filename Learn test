F.setupKeybind = function()
    if State.keybindConnection then pcall(function() State.keybindConnection:Disconnect() end); State.keybindConnection=nil end
    if not State.keybind then return end
    State.keybindConnection=S.UIS.InputBegan:Connect(function(input,gp)
        if gp then return end
        if input.KeyCode==Enum.KeyCode.H then
            if #State.hiddenGuis>0 or (GUI.ShowBtn and GUI.ShowBtn.Visible) then
                for _,g in pairs(State.hiddenGuis) do pcall(function() g.Enabled=true end) end
                State.hiddenGuis={}; if GUI.HideBtn then GUI.HideBtn.Visible=true end; if GUI.ShowBtn then GUI.ShowBtn.Visible=false end
            else
                State.hiddenGuis={}; if GUI.Screen.Enabled then GUI.Screen.Enabled=false; table.insert(State.hiddenGuis,GUI.Screen) end; if GUI.MiniScreen and GUI.MiniScreen.Enabled then GUI.MiniScreen.Enabled=false; table.insert(State.hiddenGuis,GUI.MiniScreen) end; if GUI.ExtraScreen and GUI.ExtraScreen.Enabled then GUI.ExtraScreen.Enabled=false; table.insert(State.hiddenGuis,GUI.ExtraScreen) end; if GUI.HideBtn then GUI.HideBtn.Visible=false end; if GUI.ShowBtn then GUI.ShowBtn.Visible=true end
            end
        elseif input.KeyCode==Enum.KeyCode.P then
            if State.currentSound then F.togglePause() end
        elseif input.KeyCode==Enum.KeyCode.S then
            F.stopMusic(); if GUI.StatusLabel then F.updateText(GUI.StatusLabel,"⏹ Music Stopped") end
        elseif input.KeyCode==Enum.KeyCode.M then
            if State.gameMuted then
                State.gameMuted=false; if GUI.MuteButton then F.updateText(GUI.MuteButton,"🔇 MUTE GAME"); GUI.MuteButton.BackgroundColor3=Color3.fromRGB(180,80,80) end
                for sound,vol in pairs(State.mutedSounds) do pcall(function() if sound and sound.Parent then sound.Volume=vol end end) end
                State.mutedSounds={}; pcall(function() S.SoundService.Volume=1 end)
            else
                State.gameMuted=true; if GUI.MuteButton then F.updateText(GUI.MuteButton,"🔊 UNMUTE"); GUI.MuteButton.BackgroundColor3=Color3.fromRGB(80,180,80) end
                State.mutedSounds={}; pcall(function() for _,v in pairs(workspace:GetDescendants()) do if v:IsA("Sound") and v~=State.currentSound then State.mutedSounds[v]=v.Volume; v.Volume=0 end end end); pcall(function() S.SoundService.Volume=0 end)
            end
        elseif input.KeyCode==Enum.KeyCode.L then
            State.mainLoop=not State.mainLoop; State.isLooping=State.mainLoop; State.playlistLoop=false
            if State.currentSound then State.currentSound.Looped=State.mainLoop end
            if GUI.LoopButton then F.updateText(GUI.LoopButton,State.mainLoop and "🔁 LOOP: ON" or "🔁 LOOP: OFF"); GUI.LoopButton.BackgroundColor3=State.mainLoop and Color3.fromRGB(70,180,70) or Color3.fromRGB(130,130,130) end
        end
    end)
    print("[MusicPlayer] Keybinds: H=Hide/Show, P=Play/Pause, S=Stop, M=Mute Game, L=Loop")
end

F.loadSettings = function()
    local settings=F.loadJSON(P.settings)
    if settings.theme then State.theme=settings.theme end
    if settings.saveTheme~=nil then State.saveTheme=settings.saveTheme end
    if settings.rememberKey~=nil then State.rememberKey=settings.rememberKey end
    if settings.sliderBlue~=nil then State.sliderBlue=settings.sliderBlue end
    if settings.keybind~=nil then State.keybind=settings.keybind end
    if settings.autoTranslate~=nil then State.autoTranslate=settings.autoTranslate end
    local keyData=F.loadJSON(P.key)
    if keyData.isKeyCorrect then State.keyCorrect=true; pcall(function() F.loadPlaylist() end) end
    State.userPlaylist=F.loadJSON(P.playlist)
end

