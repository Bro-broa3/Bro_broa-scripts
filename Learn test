    end
    local tp=State.currentSound.TimePosition; local tl=State.currentSound.TimeLength
    if tp~=tp then tp=0 end; if tl~=tl or tl<=0 then tl=1 end
    local timeText=F.formatTime(tp).." / "..F.formatTime(tl)
    if GUI.TimeLabel then GUI.TimeLabel.Text=State.songName~="" and (timeText.."   "..State.songName) or timeText end
