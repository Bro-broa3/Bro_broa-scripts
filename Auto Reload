local reloadURL = "https://raw.githubusercontent.com/Bro-broa3/Bro_broa-scripts/refs/heads/main/Auto%20Reload"
local mainURL = "https://raw.githubusercontent.com/Bro-broa3/Bro_broa-scripts/refs/heads/main/GitHub%20mp3%20music%20player%206.0"

local isQueued = false

-- 排队函数
local function QueueReload()
    if isQueued then return end
    if not queue_on_teleport then return end
    
    queue_on_teleport([[
        task.wait(0.1)
        loadstring(game:HttpGet("]] .. reloadURL .. [["))()
        loadstring(game:HttpGet("]] .. mainURL .. [["))()
    ]])
    isQueued = true
end

-- 立即加载主脚本（当前会话）
loadstring(game:HttpGet(mainURL))()

-- 只排一次队，不需要轮询
QueueReload()
